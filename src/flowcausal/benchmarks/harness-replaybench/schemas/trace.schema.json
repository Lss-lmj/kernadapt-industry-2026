{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-replaybench.local/schemas/trace.schema.json",
  "title": "HarnessReplayBench trace",
  "type": "object",
  "required": ["schema", "instance_id", "commands"],
  "properties": {
    "schema": {
      "const": "harness_replaybench.trace.v1"
    },
    "benchmark": {
      "const": "HarnessReplayBench"
    },
    "instance_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_format": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage", "cmd", "cwd"],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": ["INSPECT", "EDIT", "SHELL", "BUILD", "TEST", "PACKAGE_BACKGROUND", "RETRY_PROBE"]
          },
          "cmd": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "agent_cmd": {
            "type": "string"
          },
          "observed_returncode": {
            "type": "integer"
          },
          "allow_failure": {
            "type": "boolean"
          },
          "allow_failure_reason": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "frontier_label": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
